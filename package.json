{
  "name": "@tolt/tracking",
  "version": "0.1.0",
  "description": "Client-side tracking for Tolt affiliate programs: a typed wrapper around tolt.js, with a React component and hook.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "tolt",
    "affiliate",
    "referral",
    "tracking",
    "tolt.js"
  ],
  "homepage": "https://github.com/toltapp/tolt-tracking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-tracking.git"
  },
  "bugs": {
    "url": "https://github.com/toltapp/tolt-tracking/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
